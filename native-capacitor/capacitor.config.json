{
  "appId": "com.patiyiz.app",
  "appName": "BucheeSocial",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#14021e"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#14021e",
      "showSpinner": false,
      "launchFadeOutDuration": 200
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#14021e",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
